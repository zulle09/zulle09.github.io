---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { navItems, profile } from '../data/profile';
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={`${profile.name}, back to top`}>
      <span class="brand-mark" aria-hidden="true">RZ</span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav id="site-nav" class="nav" aria-label="Primary" data-nav>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
        data-menu-button
      >
        <span class="icon-open"><Icon name="menu" /></span>
        <span class="icon-close"><Icon name="x" /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  :global(.no-js) .site-header {
    position: static;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .brand-name {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu-btn {
    display: none;
  }

  :global(.js) .menu-btn {
    display: inline-grid;
  }

  .menu-btn[aria-expanded='false'] .icon-close,
  .menu-btn[aria-expanded='true'] .icon-open {
    display: none;
  }

  .nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    padding: var(--space-2) var(--gutter) var(--space-4);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  :global(.js) .nav {
    display: none;
  }

  :global(.js) .nav.is-open {
    display: block;
  }

  @media (max-width: 59.99rem) {
    :global(.no-js) .bar {
      flex-wrap: wrap;
    }

    :global(.no-js) .nav {
      position: static;
      order: 3;
      flex: 1 0 100%;
      padding: 0 0 var(--space-3);
      border: 0;
      background: none;
    }

    :global(.no-js) .nav ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-4);
    }

    :global(.no-js) .nav a {
      min-height: 2.75rem;
      border: 0;
      font-size: var(--text-sm);
    }
  }

  .nav ul {
    display: grid;
  }

  .nav a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    transition: color var(--dur-fast) ease;
  }

  .nav li:last-child a {
    border-bottom: 0;
  }

  .nav a:hover,
  .nav a[aria-current='location'] {
    color: var(--accent);
  }

  @media (min-width: 26rem) {
    .brand-name {
      display: inline;
    }
  }

  @media (min-width: 60rem) {
    .menu-btn,
    :global(.js) .menu-btn {
      display: none;
    }

    .nav,
    :global(.js) .nav {
      position: static;
      display: block;
      padding: 0;
      background: none;
      border: 0;
    }

    .nav ul {
      display: flex;
      gap: var(--space-1);
    }

    .nav a,
    .nav li:last-child a {
      position: relative;
      min-height: 2.75rem;
      padding-inline: var(--space-3);
      border: 0;
      font-size: var(--text-sm);
    }

    .nav a::after {
      content: '';
      position: absolute;
      left: var(--space-3);
      right: var(--space-3);
      bottom: 0.5rem;
      height: 2px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--dur-base) var(--ease-out);
    }

    .nav a:hover::after,
    .nav a[aria-current='location']::after {
      transform: scaleX(1);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const desktopQuery = window.matchMedia('(min-width: 60rem)');

  function setMenu(open: boolean): void {
    nav?.classList.toggle('is-open', open);
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  menuButton?.addEventListener('click', () => {
    setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  links.forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (menuButton?.getAttribute('aria-expanded') !== 'true') return;
    if (event.target instanceof Node && !header?.contains(event.target)) setMenu(false);
  });

  desktopQuery.addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });

  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);

  function setCurrent(id: string | null): void {
    links.forEach((link) => {
      if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setCurrent(entry.target.id);
        });
      },
      { rootMargin: '-30% 0px -65% 0px' },
    );
    sections.forEach((section) => observer.observe(section));

    window.addEventListener(
      'scroll',
      () => {
        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        if (atBottom && sections.length > 0) setCurrent(sections[sections.length - 1].id);
        else if (window.scrollY < 80) setCurrent(null);
      },
      { passive: true },
    );
  }
</script>
