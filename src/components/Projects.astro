---
import Icon from './Icon.astro';
import { projects } from '../data/profile';
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">
        <span class="index" aria-hidden="true">03</span>
        <span class="rule" aria-hidden="true"></span>
        <span>Projects</span>
      </p>
      <h2 id="projects-title" class="section-title">Selected projects.</h2>
    </div>

    <ul class="grid">
      {
        projects.map((project, position) => (
          <li class={`cell cell-${project.size}`} data-reveal style={`--reveal-delay: ${(position % 2) * 50}ms`}>
            <article class="card">
              <div class="top">
                <p class="kicker">
                  <span aria-hidden="true">{project.index}</span>
                  <span>{project.kicker}</span>
                </p>
                <svg class="glyph" viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {project.glyph === 'graph' && (
                    <>
                      <path d="M12 48 24 40 28 16 48 32 52 52 24 40M28 16 12 48M48 32 24 40" />
                      <circle cx="12" cy="48" r="4" />
                      <circle cx="28" cy="16" r="4" />
                      <circle cx="24" cy="40" r="4" />
                      <circle cx="52" cy="52" r="4" />
                      <circle cx="48" cy="32" r="5.5" fill="currentColor" />
                    </>
                  )}
                  {project.glyph === 'cube' && (
                    <>
                      <path d="M32 8 54 20v24L32 56 10 44V20Z" />
                      <path d="M32 32v24M32 32 10 20M32 32 54 20" />
                      <path d="M32 32 54 20v24L32 56Z" fill="currentColor" fill-opacity="0.2" stroke="none" />
                    </>
                  )}
                  {project.glyph === 'chat' && (
                    <>
                      <path d="M10 12h44a4 4 0 0 1 4 4v24a4 4 0 0 1-4 4H30L18 54V44h-8a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4Z" />
                      <circle cx="22" cy="28" r="2.5" fill="currentColor" stroke="none" />
                      <circle cx="32" cy="28" r="2.5" fill="currentColor" stroke="none" />
                      <circle cx="42" cy="28" r="2.5" fill="currentColor" stroke="none" />
                    </>
                  )}
                  {project.glyph === 'wave' && (
                    <path d="M8 26v12M16 18v28M24 8v48M32 20v24M40 12v40M48 22v20M56 27v10" stroke-width="3" />
                  )}
                </svg>
              </div>

              <h3>{project.title}</h3>
              <p class="description">{project.description}</p>

              <div class="bottom">
                <ul class="chips" aria-label="Topics">
                  {project.tags.map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
                {project.links.length > 0 && (
                  <ul class="links">
                    {project.links.map((link) => (
                      <li>
                        <a
                          class="link"
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${link.label}: ${project.title} (opens in a new tab)`}
                        >
                          <Icon name={link.kind === 'code' ? 'code' : 'file-text'} size={18} />
                          <span>{link.label}</span>
                          <Icon name="arrow-up-right" size={16} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition:
      border-color var(--dur-base) ease,
      transform var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--accent-line);
      transform: translateY(-2px);
    }
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .kicker span:first-child {
    color: var(--accent);
  }

  .glyph {
    flex: none;
    color: var(--accent);
    opacity: 0.85;
  }

  h3 {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .description {
    max-width: 40rem;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .bottom {
    display: grid;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .card {
      padding: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .cell-wide {
      grid-column: span 7;
    }

    .cell-narrow {
      grid-column: span 5;
    }
  }
</style>
