---
const width = 1200;
const height = 160;
const sampleCount = 160;
const anomalyIndex = 104;

function seededRandom(seed: number): () => number {
  let state = seed;
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let mixed = Math.imul(state ^ (state >>> 15), 1 | state);
    mixed = (mixed + Math.imul(mixed ^ (mixed >>> 7), 61 | mixed)) ^ mixed;
    return ((mixed ^ (mixed >>> 14)) >>> 0) / 4294967296;
  };
}

const random = seededRandom(7);
const points = Array.from({ length: sampleCount }, (_, index): [number, number] => {
  const x = (index / (sampleCount - 1)) * width;
  const wave = Math.sin(index / 9) * 12 + Math.sin(index / 3.7) * 5;
  const noise = (random() - 0.5) * 9;
  const offset = index - anomalyIndex;
  let y = 84 + wave + noise;
  if (offset === 0) y = 14;
  else if (offset === 1) y = 146;
  else if (offset === 2) y = 52;
  return [x, y];
});

const path = points
  .map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`)
  .join(' ');
const [anomalyX, anomalyY] = points[anomalyIndex];
---

<div class="signal" aria-hidden="true">
  <svg viewBox={`0 0 ${width} ${height}`} focusable="false">
    <g class="guides">
      <line x1="0" x2={width} y1="40" y2="40"></line>
      <line x1="0" x2={width} y1="84" y2="84"></line>
      <line x1="0" x2={width} y1="128" y2="128"></line>
    </g>
    <path class="trace" d={path} pathLength="1"></path>
    <g class="flag" transform={`translate(${anomalyX.toFixed(1)} ${anomalyY.toFixed(1)})`}>
      <circle class="ring" r="14"></circle>
      <circle class="dot" r="4.5"></circle>
    </g>
  </svg>
</div>

<style>
  .signal {
    display: flex;
    justify-content: center;
    overflow: hidden;
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  svg {
    flex: none;
    width: max(100%, 56rem);
    height: auto;
    overflow: visible;
  }

  .guides line {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .trace {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.2s var(--ease-out) 0.3s forwards;
  }

  .flag {
    opacity: 0;
    animation: appear 0.4s var(--ease-out) 1.5s forwards;
  }

  .dot {
    fill: var(--accent);
  }

  .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 1.4s ease-out 1.6s 2;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }

  @keyframes pulse {
    from {
      transform: scale(0.6);
      opacity: 0.9;
    }
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace {
      animation: none;
      stroke-dashoffset: 0;
    }

    .flag {
      animation: none;
      opacity: 1;
    }

    .ring {
      animation: none;
      opacity: 0.35;
    }
  }
</style>
