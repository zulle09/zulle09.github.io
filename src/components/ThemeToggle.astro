---
import Icon from './Icon.astro';
---

<button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme">
  <span class="sun"><Icon name="sun" /></span>
  <span class="moon"><Icon name="moon" /></span>
</button>

<style>
  .theme-toggle {
    display: none;
  }

  :global(.js) .theme-toggle {
    display: inline-grid;
  }

  :global([data-theme='dark']) .moon,
  :global([data-theme='light']) .sun {
    display: none;
  }
</style>

<script>
  type Theme = 'dark' | 'light';

  const themeColors: Record<Theme, string> = { dark: '#0b0d10', light: '#fafaf9' };
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  function applyTheme(theme: Theme): void {
    root.dataset.theme = theme;
    themeColorMeta?.setAttribute('content', themeColors[theme]);
    button?.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  }

  applyTheme(root.dataset.theme === 'light' ? 'light' : 'dark');

  button?.addEventListener('click', () => {
    const next: Theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    applyTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage is blocked: the choice applies to this visit only.
    }
  });
</script>
